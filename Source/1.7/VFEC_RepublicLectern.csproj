<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prepared for RimWorld 1.7 (not built yet): same sources as the 1.6 project, net10.0 target. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VFEC_RepublicLectern</AssemblyName>
    <RootNamespace>VFEC_RepublicLectern</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Source code is shared with the 1.6 project -->
  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\1.7\**;..\obj\**;..\bin\**" />
  </ItemGroup>

  <PropertyGroup>
    <RimWorldPath Condition="'$(RimWorldPath)'==''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldModPath Condition="'$(RimWorldModPath)'==''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</RimWorldModPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.7 core assemblies live at the game root; UnityEngine.* is replaced by UnityStubs -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldPath)\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RimWorldModPath)\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VEF">
      <HintPath>$(RimWorldModPath)\2023507013\1.7\Assemblies\VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VFE Classical has no 1.7 folder: its LoadFolders.xml loads the 1.6 assembly on v1.7 -->
    <Reference Include="VFEC">
      <HintPath>$(RimWorldModPath)\2787850474\1.6\Assemblies\VFEC.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
